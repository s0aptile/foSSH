/target
/crates/*/target
/crates/fossh-ffi/target
/dist
/fossh-oa.zip
/fossh-oa-*.zip
SHA256SUMS
PUBLISH.md
/private-onlyauthor/
*.swp
.DS_Store
__MACOSX/
.env
*.env
/fuzz/corpus
/fuzz/artifacts

# Operator-downloaded GeoIP database (see NOTICE, README's "Country
# resolution (GeoIP)"): never vendored into the source tree or a
# release artifact, so it must never be committed either.
/assets/geoip/*.mmdb
/assets/geoip/*.mmdb.gz

# Python bytecode. Generated on every import of gui/fossh_console, and
# it reached a release zip once because the zip includes untracked
# files by design (so the public source drop is the real tree, not
# just what happens to be committed).
__pycache__/
*.py[cod]

# Graveyard archives. The tarballs are reproducible from their own
# retirement tags (see graveyard/README.md), so committing them would
# store a second copy of history inside history. The README and the
# checksums are tracked; the archives are not.
/graveyard/*/*.tar.gz
